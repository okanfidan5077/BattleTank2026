{
  "name": "battletank2026",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BattleTank2026 monorepo — Colyseus server + Phaser client + shared types.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "build:shared": "npm run build --workspace @battletank/shared",
    "build:server": "npm run build --workspace @battletank/server",
    "build:client": "npm run build --workspace @battletank/client",
    "clean": "tsc -b --clean",
    "dev:server": "npm run dev --workspace @battletank/server",
    "dev:client": "npm run dev --workspace @battletank/client",
    "watch:shared": "npm run dev --workspace @battletank/shared",
    "typecheck": "tsc -b --force",
    "start:server": "npm run start --workspace @battletank/server",
    "test:smoke": "node scripts/smoke-campaign.mjs",
    "test:levels": "node scripts/verify-campaign40.mjs",
    "test:systems": "node scripts/verify-new-systems.mjs",
    "test:laser": "node scripts/verify-laser.mjs",
    "test:ordered": "node scripts/verify-ordered.mjs",
    "test:feedback": "node scripts/verify-feedback.mjs",
    "test:rushers": "node scripts/verify-rushers.mjs",
    "test:campaign": "node scripts/verify-campaign40.mjs && node scripts/verify-new-systems.mjs && node scripts/verify-laser.mjs && node scripts/verify-ordered.mjs && node scripts/verify-feedback.mjs && node scripts/verify-rushers.mjs && node scripts/verify-fixes.mjs && node scripts/verify-bosses.mjs && node scripts/verify-fire-and-effigy.mjs && node scripts/verify-architect.mjs",
    "skip-to": "node scripts/skip-to.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@colyseus/core": "0.16.24"
  }
}

# Dependencies — reinstalled from the lockfile inside the builder stage.
node_modules
**/node_modules

# Build outputs — regenerated by the builder; never ship stale host builds.
dist
**/dist
**/*.tsbuildinfo
packages/client/node_modules/.tmp

# Version control & CI metadata.
.git
.gitignore
.gitattributes
.github

# Docker's own files.
Dockerfile
.dockerignore
docker-compose*.yml

# Local environment, logs, and editor/OS cruft.
.env
.env.*
*.log
npm-debug.log*
.vscode
.idea
.DS_Store
Thumbs.db
